{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-x64",
      "displayName": "Windows x64 (MSVC / VS 18 2026)",
      "description": "统一入口：引擎 + 插件宿主 + 桥；产物仍写回各子工程 out/<Config>/，构建树在 build/windows/x64。",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/windows/x64"
    },
    {
      "name": "linux-x64",
      "displayName": "Linux x64 (占位)",
      "description": "占位：M6 后才由 Linux 主机启用；本轮根工程在非 Windows 上直接报错。",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux/x64"
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x64-release",
      "configurePreset": "windows-x64",
      "configuration": "Release"
    },
    {
      "name": "windows-x64-debug",
      "configurePreset": "windows-x64",
      "configuration": "Debug"
    }
  ]
}

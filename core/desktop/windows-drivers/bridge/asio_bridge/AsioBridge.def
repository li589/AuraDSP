LIBRARY auraasio_bridge
EXPORTS
    ; ---- ASIO 专属面（不在统一契约内）----
    asio_abi               PRIVATE
    asio_plugin_slot_load              PRIVATE
    asio_plugin_slot_unload            PRIVATE
    asio_plugin_slot_set_bypass        PRIVATE
    asio_plugin_slot_get_bypass        PRIVATE
    asio_plugin_slot_get_latency       PRIVATE
    asio_plugin_slot_get_status        PRIVATE
    asio_plugin_slot_show_editor       PRIVATE
    asio_plugin_slot_close_editor      PRIVATE
    asio_plugin_slot_is_editor_open    PRIVATE
    asio_plugin_slot_save_preset       PRIVATE
    asio_plugin_slot_load_preset       PRIVATE
    asio_plugin_slot_set_insert_stage  PRIVATE
    asio_plugin_slot_get_insert_stage  PRIVATE
    asio_plugin_slot_set_channels      PRIVATE
    asio_plugin_slot_get_channels      PRIVATE
    ; ---- 统一桥契约（bridge/common/aurabridge.h）：唯一公共导出面 ----
    ab_abi_version        PRIVATE
    ab_capabilities       PRIVATE
    ab_detect             PRIVATE
    ab_start              PRIVATE
    ab_stop               PRIVATE
    ab_status             PRIVATE
    ab_set_param          PRIVATE
    ab_set_param_str      PRIVATE
    ab_get_param          PRIVATE
    ab_get_param_str      PRIVATE
    ab_viz_read           PRIVATE
    ab_bypass             PRIVATE
    ab_test_start         PRIVATE
    ab_test_stop          PRIVATE

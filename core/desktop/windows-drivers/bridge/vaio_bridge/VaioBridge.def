LIBRARY auravaio_bridge
EXPORTS
    ; ---- VAIO 专属面（不在统一契约内）----
    vaio_abi
    vaio_plugin_slot_load
    vaio_plugin_slot_unload
    vaio_plugin_slot_set_bypass
    vaio_plugin_slot_get_bypass
    vaio_plugin_slot_get_latency
    vaio_plugin_slot_get_status
    vaio_plugin_slot_show_editor
    vaio_plugin_slot_close_editor
    vaio_plugin_slot_is_editor_open
    vaio_plugin_slot_save_preset
    vaio_plugin_slot_load_preset
    vaio_plugin_slot_set_insert_stage
    vaio_plugin_slot_get_insert_stage
    vaio_plugin_slot_set_channels
    vaio_plugin_slot_get_channels
    ; ---- 统一桥契约（bridge/common/aurabridge.h）：唯一公共导出面 ----
    ab_abi_version
    ab_capabilities
    ab_detect
    ab_start
    ab_stop
    ab_status
    ab_set_param
    ab_set_param_str
    ab_get_param
    ab_get_param_str
    ab_viz_read
    ab_bypass
    ab_test_start
    ab_test_stop

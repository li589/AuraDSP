  <ItemGroup>
    <ClCompile Include="driver.cpp" />
    <ClCompile Include="device.cpp" />
  </ItemGroup>
  <ItemGroup>
    <Inf Include="AuraVaioDriver.inf" />
  </ItemGroup>
</Project>

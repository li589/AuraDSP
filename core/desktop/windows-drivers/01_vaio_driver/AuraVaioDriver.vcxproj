<!--
  AuraVaioDriver.vcxproj — MODERN 主线 (WDK 28000 + VS2026, Win10 1809+/Win11 x64)
  说明：这是 KMDF 内核驱动的“最小可编译骨架”，用于先打通工具链。
  真正的 AuraVAIO 虚拟声卡 = PortCls WaveRT 微端口（移植 Windows-driver-samples/audio/sysvad），
  不属于本骨架的代码范围，后续在 device.cpp 中按 TODO 接入。
  WindowsTargetPlatformVersion 必须与已装 SDK/WDK 的 build 号一致（此处 28000）。
  PlatformToolset 用 $(DefaultPlatformToolset) 自动取 VS2026 默认，跨 VS 版本安全。
-->
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="Globals">

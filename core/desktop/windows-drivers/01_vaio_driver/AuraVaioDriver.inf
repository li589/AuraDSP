; AuraVaioDriver.inf — MODERN 主线 KMDF 驱动 INF（Root 枚举软件设备骨架）
; 真实驱动需改为 WaveRT 音频设备 INF（参考 sysvad 的 inf）。
[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4d36e97d-e325-11ce-bfc1-08002be10318}
Provider=%ManufacturerName%
CatalogFile=AuraVaioDriver.cat
DriverVer=10/15/2026,1.0.0.0
PnpLockDown=1

[DestinationDirs]
DefaultDestDir = 12

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
AuraVaioDriver.sys = 1,,

[Manufacturer]
%ManufacturerName%=Standard,NTamd64

[Standard.NTamd64]
%AuraVaioDriver.DeviceDesc%=AuraVaioDriver_Device, Root\AuraVaioDriver

[AuraVaioDriver_Device.NT]
CopyFiles=Drivers_Dir

[AuraVaioDriver_Device.NT.Services]
AddService=AuraVaioDriver,,AuraVaioDriver_Service

[AuraVaioDriver_Device.NT.CopyFiles]
AuraVaioDriver.sys

[AuraVaioDriver_Service]
DisplayName    = %AuraVaioDriver.SvcDesc%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %12%\AuraVaioDriver.sys

[Strings]
ManufacturerName="AuraDSP"
DiskName="AuraVAIO Driver Installation Disk"
AuraVaioDriver.DeviceDesc="AuraVAIO Virtual Audio Driver (skeleton)"
AuraVaioDriver.SvcDesc="AuraVAIO Virtual Audio Driver Service"
